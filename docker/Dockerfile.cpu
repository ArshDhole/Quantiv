# Quantiv CPU image: CLI + analyzer + HQQ/GGUF + eval + dashboard.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake curl git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ src/
COPY configs/ configs/

RUN pip install --upgrade pip && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install -e ".[core-ml,gguf,hqq,calib,web,dev]" && \
    pip install pytest ruff

EXPOSE 8020
ENTRYPOINT ["quantiv"]
CMD ["doctor"]
